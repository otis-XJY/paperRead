python .\feishu_permission_check.py `
  --doc-token "K8liwBP5piLU5zkujfncOY18nsg"
# ============================================
# Zotero AI Daily Papers - Configuration Template
# ============================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env file to version control!
# ============================================

# ============================================
# REQUIRED CONFIGURATION
# ============================================

# Zotero User ID - Found in your Zotero account settings
ZOTERO_USER_ID=your_zotero_user_id_here

# Zotero API Key - Create at https://www.zotero.org/settings/keys
# Recommended permissions: Read access, Write access, Allow notes access
ZOTERO_API_KEY=your_zotero_api_key_here

# LLM API Keys - Configure one or more providers. Calls use all configured
# endpoints with equal-priority failover, while provider keys stay in .env.
# Option 1: ModelScope
# Get your API key from https://modelscope.cn/
MODELSCOPE_API_KEY=your_modelscope_api_key_here

# Option 2: Zhipu AI / BigModel (OpenAI-compatible REST API)
# Create a key at https://open.bigmodel.cn/
ZHIPUAI_API_KEY=

# Option 3: OpenAI
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Option 4: Other OpenAI-compatible providers.
# Their API addresses and models are set in DEFAULT_EXTRA_PROVIDERS in
# llm_client.py; GitHub Actions provides only these matching Secrets.
LLM_PROVIDER_1_API_KEY=
LLM_PROVIDER_2_API_KEY=
LLM_PROVIDER_3_API_KEY=

# ============================================
# OPTIONAL CONFIGURATION - Notifications
# ============================================

# Feishu Bot Webhook URL
# 1. Create a custom bot in Feishu
# 2. Get the webhook URL from bot settings
FEISHU_WEBHOOK_URL=

# WeChat Work Bot Webhook URL
# 1. Create a group bot in WeChat Work
# 2. Get the webhook URL from bot settings
WXWORK_WEBHOOK_URL=

# ============================================
# OPTIONAL CONFIGURATION - Feishu Wiki
# ============================================

# Feishu self-built app credentials (for wiki mirroring)
# Create at https://open.feishu.cn/app
# Required scopes: wiki:wiki, docx:document, space:document:delete
# space:document:delete lets startup deduplication move duplicate Wiki paper
# documents to the Feishu recycle bin.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_PAPER_CHAT_ID=

# Target wiki root node token（你想作为「父目录」的那篇知识库文档）
# 从浏览器地址栏复制： https://my.feishu.cn/wiki/MxX2wIS7DiUhKEkVq9OcwaaCnqd → token 为 MxX2wIS7DiUhKEkVq9OcwaaCnqd
FEISHU_WIKI_ROOT_NODE_TOKEN=

# 根节点下第一层文件夹名称（其下再按 main.py 里 CONFIG["categories"] 建 UAV_VLN 等分类）
# 默认 DailyPapers；若希望显示为「DailyPaper」可改为 DailyPaper
FEISHU_WIKI_DAILY_FOLDER_NAME=DailyPapers

# 浏览器打开文档时的站点根（默认国内 my.feishu.cn）。国际化租户可改为 https://xxx.feishu.net 等
FEISHU_WEB_BASE=https://my.feishu.cn

# ============================================
# OPTIONAL CONFIGURATION - Daily Work Report Bot
# ============================================
# These belong to a separate Feishu enterprise self-built app with Bot enabled.
DAILY_REPORT_FEISHU_APP_ID=
DAILY_REPORT_FEISHU_APP_SECRET=
DAILY_REPORT_FEISHU_WIKI_ROOT_NODE_TOKEN=
# OAuth is used only by the local discovery/subscription task.  The event
# listener itself remains application-identity based.
DAILY_REPORT_FEISHU_OAUTH_STORE=D:/paperRead-runtime/feishu_oauth_tokens.json
DAILY_REPORT_FEISHU_USER_OPEN_ID=
FEISHU_OAUTH_REDIRECT_URI=http://127.0.0.1:8765/feishu/oauth/callback
# User OAuth scopes required for cloud-drive/Wiki discovery and subscription.
# These must also be enabled for user identity in the Feishu app.
FEISHU_OAUTH_SCOPE=drive:drive docx:document:readonly wiki:wiki:readonly sheets:spreadsheet:readonly bitable:app:readonly
# Optional extra cloud-drive folder roots. The personal root is discovered
# automatically; add shared folder tokens here when needed.
FEISHU_DISCOVERY_DRIVE_ENABLED=1
FEISHU_DISCOVERY_FOLDER_TOKENS=
FEISHU_DISCOVERY_WIKI_ENABLED=1
FEISHU_DISCOVERY_WIKI_SPACE_IDS=
FEISHU_DISCOVERY_FILE_TOKENS=
# The target group chat ID, usually beginning with oc_
DAILY_REPORT_FEISHU_CHAT_ID=
# Optional independent chat for PaperRead daily paper notifications.
DAILY_REPORT_PAPERREAD_CHAT_ID=
DAILY_REPORT_PAPERREAD_SENDER_ID=
DAILY_REPORT_PAPERREAD_APP_ID=
DAILY_REPORT_MAX_CHAT_MESSAGES=500
DAILY_REPORT_MAX_PAPERREAD_MESSAGES=100
# Optional: configure the single person whose questions should be answered.
# Prefer DAILY_REPORT_QUESTION_SENDER_ID; keep both values out of source code.
DAILY_REPORT_QUESTION_SENDER_NAME=
DAILY_REPORT_QUESTION_SENDER_ID=
# Local ActivityWatch server (default: http://127.0.0.1:5600)
ACTIVITYWATCH_URL=http://127.0.0.1:5600
DAILY_REPORT_ACTIVITY_CLEAR_ENABLED=1
DAILY_REPORT_ACTIVITY_CLEAR_MAX_SECONDS=30

# Local Feishu document event queue. The Windows listener and daily report
# must use the same path on the self-hosted machine.
DAILY_REPORT_FEISHU_EVENT_DB=feishu_document_events.sqlite3
# Local event/resource retention. Set a row/day limit to 0 to disable that
# cleanup. No document body is stored.
DAILY_REPORT_FEISHU_EVENT_MAX_ROWS=5000
DAILY_REPORT_FEISHU_EVENT_RAW_MAX_CHARS=1000
DAILY_REPORT_FEISHU_RESOURCE_MAX_ROWS=10000
DAILY_REPORT_FEISHU_RESOURCE_RETENTION_DAYS=7

# Windows focus watcher settings
FOCUS_ACTIVE_SECONDS=60
FOCUS_EVENT_BATCH_SECONDS=60

# Daily report topic/noise/focus controls
DAILY_REPORT_MIN_THEME_MINUTES=10
DAILY_REPORT_MIN_CORE_THEME_MINUTES=20
DAILY_REPORT_SWITCH_MIN_SECONDS=30
DAILY_REPORT_SESSION_GAP_SECONDS=180
DAILY_REPORT_DEEP_FOCUS_MINUTES=25
DAILY_REPORT_SHOW_EVIDENCE=0
DAILY_REPORT_SHOW_DEBUG_APPENDIX=0
DAILY_REPORT_SHOW_APPLICATION_BREAKDOWN=0
DAILY_REPORT_SHOW_NON_WORK=0
# Timestamped CI progress logs (set to 0 to silence them)
DAILY_REPORT_PROGRESS=1

# ============================================
# OPTIONAL CONFIGURATION - Behavior
# ============================================

# Enable/disable notifications (1: enable, 0: disable)
ENABLE_NOTIFICATION=1

# Dry run mode - doesn't write to Zotero (1: dry run, 0: normal)
# Useful for testing configuration and API calls
DRY_RUN=0

# Debug mode for stage one analysis (1: verbose, 0: concise)
# Shows detailed LLM output during relevance filtering
DEBUG_PHASE_ONE=1

# ============================================
# ADVANCED CONFIGURATION
# ============================================

# Custom LLM Model (if different from default)
# LLM_MODEL=Qwen/Qwen3.5-35B-A3B
# GitHub Actions LLM timeout/retry controls
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=0
LLM_MAX_ROUNDS=1

# Custom LLM Base URL (if different from default)
# BASE_URL=https://api-inference.modelscope.cn/v1/

# ============================================
# NOTES
# ============================================
# 1. Never commit this .env file to version control
# 2. Keep your API keys secure and rotate them regularly
# 3. Use .env for local development, use GitHub Secrets for CI/CD
# 4. For GitHub Actions, configure secrets in repository settings
